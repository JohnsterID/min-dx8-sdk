# EditorConfig for min-dx8-sdk
# https://editorconfig.org

root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

# C/C++ source and headers
[*.{h,hpp,c,cpp,inl}]
indent_style = space
indent_size = 4

# CMake files
[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

# Python scripts
[*.py]
indent_style = space
indent_size = 4

# Markdown documentation
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# Batch and shell scripts
[*.{bat,sh}]
end_of_line = crlf

[*.sh]
end_of_line = lf

# Windows-specific files
[*.{rc,def,spec}]
end_of_line = crlf
